{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pterm",
  "version": "../package.json",
  "identifier": "com.pterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pterm",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "跨平台 SSH 终端客户端",
    "longDescription": "pterm 是一个跨平台 SSH 终端客户端。核心只做 SSH，Git 同步、AI 助手、SFTP、端口转发等全部为可插拔模块，可在设置中单独开关。",
    "copyright": "pterm",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMzlGMUZGNjI0QTM3RUMKUldUc04wcGkvL0U1TDhxVmRqeXBTWmMxOTNBcXBjd3pXT3hDRkxvb2puN0x0ZjJROHgrcWU1dnUK",
      "endpoints": [
        "https://github.com/willasn/pterm/releases/latest/download/latest.json"
      ]
    }
  }
}
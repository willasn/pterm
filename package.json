{
  "name": "pterm",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "跨平台 SSH 终端客户端前端（Vite + React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noFallthroughCasesInSwitch",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "version": "node scripts/sync-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
